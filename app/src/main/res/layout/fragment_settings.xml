<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/compactSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/switch_min_height"
        android:text="@string/compact_cards" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/reminderSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_spacing"
        android:minHeight="@dimen/switch_min_height"
        android:text="@string/walk_reminder" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_spacing"
        android:text="@string/settings_hint"
        android:textColor="@color/summary_text"
        android:textSize="@dimen/place_summary_size" />

</LinearLayout>
