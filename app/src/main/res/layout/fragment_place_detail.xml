<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <ImageView
            android:id="@+id/detailIcon"
            android:layout_width="@dimen/detail_icon_size"
            android:layout_height="@dimen/detail_icon_size"
            android:contentDescription="@string/place_icon"
            android:padding="@dimen/icon_padding" />

        <TextView
            android:id="@+id/detailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:textColor="@color/title_text"
            android:textSize="@dimen/detail_title_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detailBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:lineSpacingExtra="@dimen/body_line_spacing"
            android:textColor="@color/body_text"
            android:textSize="@dimen/body_text_size" />
    </LinearLayout>
</ScrollView>
